+ * WHATSOEVER RESULTING FROM LOSS OF USE, DATA OR PROFITS, WHETHER IN AN
+ * ACTION OF CONTRACT, NEGLIGENCE OR OTHER TORTIOUS ACTION, ARISING OUT OF
+ * OR IN CONNECTION WITH THE USE OR PERFORMANCE OF THIS SOFTWARE.
+ */
+#ifndef TMUX_IDE_JOURNAL_H
+#define TMUX_IDE_JOURNAL_H
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+#define TI_CAPACITY 4096
+#define TI_MAX_BATCH 256
+#define TI_MAX_WAITERS 4
+enum ti_transport {
+	TI_TRANSPORT_UNKNOWN,
+	TI_TRANSPORT_CLI,
+	TI_TRANSPORT_CONTROL
+};
+enum ti_derivation { TI_DIRECT, TI_CHILD, TI_HOOK, TI_BACKGROUND };
+struct ti_origin {
+	uint64_t issuer_id, request_id, parent_id;
+	uint32_t transport, derivation;
+};
+/* Metadata only. Zero ids mean unavailable, never an inferred target client. */
+struct ti_record {
+	uint64_t sequence, command_id, issuer_id, monotonic_us, count;
+	uint64_t request_id, parent_id;
+	uint32_t target_id, kind, outcome, flags, transport, derivation;
+};
+struct ti_ring {
+	uint64_t newest;
+	struct ti_record records[TI_CAPACITY];
+};
+_Static_assert(sizeof(struct ti_ring) <= 2 * 1024 * 1024,
+	       "journal memory bound");
+static inline uint64_t
+ti_oldest(const struct ti_ring *r)
+{
+	return r->newest < TI_CAPACITY ? 1 : r->newest - TI_CAPACITY + 1;
+}
+/* No allocation, callbacks or I/O. Caller resets epoch on counter exhaustion.
+ */
+static inline int
+ti_append(struct ti_ring *r, const struct ti_record *record)
+{
+	struct ti_record copy;
+	if (r->newest == UINT64_MAX)
+		return 0;
+	copy = *record;
+	copy.sequence = ++r->newest;
+	r->records[(copy.sequence - 1) % TI_CAPACITY] = copy;
+	return 1;
+}
+static inline const struct ti_record *
+ti_at(const struct ti_ring *r, uint64_t seq)
+{
+	if (!seq || seq < ti_oldest(r) || seq > r->newest)
+		return NULL;
+	return &r->records[(seq - 1) % TI_CAPACITY];
+}
+#endif
