+static int
+cmdq_session_guard_valid(const struct ti_session_guard *guard)
+{
+	struct session *session = session_find(guard->name);
+	return session && session->id == guard->id &&
+	    session->creation_time.tv_sec >= 0 &&
+	    (uint64_t)session->creation_time.tv_sec == guard->created;
+}
+
+struct ti_session_guard *
+cmdq_session_guard_new(const char *name, u_int id, uint64_t created)
+{
+	struct ti_session_guard *guard;
+	size_t length = strlen(name);
+	if (!length || length > 4096)
+		return NULL;
+	guard = calloc(1, sizeof *guard + length + 1);
+	if (!guard)
+		return NULL;
+	guard->references = 1;
+	guard->id = id;
+	guard->created = created;
+	memcpy(guard->name, name, length + 1);
+	return guard;
+}
+
+void
+cmdq_session_guard_free(struct ti_session_guard *guard)
+{
+	if (guard && --guard->references == 0)
+		free(guard);
+}
+
+void
+cmdq_set_session_guard(struct cmdq_item *item, struct ti_session_guard *guard)
+{
+	if (!guard)
+		return;
+	/* Caller bounds the original direct command chain to at most 64 items. */
+	for (; item != NULL; item = item->next) {
+		item->session_guard = guard;
+		guard->references++;
+	}
+}
+
+/* Immutable observation context: deliberately independent of target state. */
+void cmdq_set_origin(struct cmdq_item *item, const struct ti_origin *origin)
+{
+	for (; item != NULL; item = item->next) {
