+	origin.issuer_id = client ? client->tmux_ide_connection_id : 0;
+	origin.request_id = tmux_ide_interaction_request();
+	origin.transport = transport;
+	return origin;
+}
+
+void cmdq_set_origin_client(struct cmdq_item *item, struct client *client,
+			    unsigned transport)
+{
+	struct ti_origin origin = cmdq_client_origin(client, transport);
+	cmdq_set_origin(item, &origin);
+}
+
+void cmdq_set_state_origin_client(struct cmdq_state *state,
+				  struct client *client, unsigned transport)
+{
+	state->origin = cmdq_client_origin(client, transport);
+}
+
+struct ti_origin cmdq_origin_child(struct cmdq_item *item, unsigned derivation)
+{
+	struct ti_origin origin = item->origin;
+	origin.parent_id = item->interaction_command_id;
+	origin.derivation = derivation;
+	return origin;
