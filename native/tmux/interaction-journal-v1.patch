+	ti_uuid(ti_server_epoch);
+	ti_uuid(ti_journal_epoch);
+	evtimer_set(&ti_wakeup, ti_wake, NULL);
+	ti_wakeup_initialized = 1;
+}
+static void
+ti_degrade(unsigned reason)
+{
+	if (ti_degraded & reason)
+		return;
+	ti_degraded |= reason;
+	if (ti_journal && !ti_wakeup_pending) {
+		ti_wakeup_pending = 1;
+		event_active(&ti_wakeup, EV_TIMEOUT, 1);
+	}
