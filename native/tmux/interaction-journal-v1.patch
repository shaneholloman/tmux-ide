+/* Shared physical-grid serializer. Bounded callers supply their payload cap.
+ * Ordinary -R retains its existing output and no new size policy. */
+static char *
+cmd_capture_pane_native(struct cmdq_item *item, struct window_pane *wp,
+    struct screen *s, struct grid *gd, u_int top, u_int bottom,
+    size_t limit, size_t *len)
+{
+	struct grid_cell cell;
+	const struct grid_line *gl;
+	struct ti_snapshot_buffer buffer = { .limit = limit };
+	u_int i;
+	int n;
+	u_int x, k;
+	char record[512], hex[sizeof cell.data.data * 2 + 1], attrs[128];
+
+	if (s == &wp->base) {
+		input_current_cell(wp->ictx, &cell);
+		snprintf(attrs, sizeof attrs, "[%u,%d,%d,%d]",
+		    cell.attr, cell.fg, cell.bg, cell.us);
+	} else
+		snprintf(attrs, sizeof attrs, "null");
+	n = snprintf(record, sizeof record,
+	    "{\"version\":2,\"cols\":%u,\"rows\":%u,"
+	    "\"history\":%u,\"hscrolled\":%u,\"limit\":%u,"
+	    "\"cursor\":[%u,%u],\"currentAttributes\":%s}\n",
+	    gd->sx, gd->sy, gd->hsize, gd->hscrolled, gd->hlimit,
+	    s->cx, s->cy, attrs);
+	if (n < 0 || (size_t)n >= sizeof record ||
+	    ti_snapshot_append(&buffer, record, (size_t)n) != 0)
+		goto fail;
+	for (i = top; i <= bottom; i++) {
+		gl = grid_peek_line(gd, i);
+		n = snprintf(record, sizeof record,
+		    "{\"row\":%u,\"flags\":%d,\"used\":%u,\"cells\":[",
+		    i, gl->flags, gl->cellused);
+		if (n < 0 || (size_t)n >= sizeof record ||
+		    ti_snapshot_append(&buffer, record, (size_t)n) != 0)
+			goto fail;
+		for (x = 0; x < gl->cellsize; x++) {
+			grid_get_cell(gd, x, i, &cell);
+			for (k = 0; k < cell.data.size; k++)
+				snprintf(hex + k * 2, 3, "%02x", cell.data.data[k]);
+			hex[cell.data.size * 2] = '\0';
+			n = snprintf(record, sizeof record,
+			    "%s[%d,%u,\"%s\",%u,%d,%d,%d,%u,%d]",
+			    x ? "," : "", cell.flags, cell.data.width, hex,
+			    cell.attr, cell.fg, cell.bg, cell.us, cell.link,
+			    gl->celldata[x].flags);
+			if (n < 0 || (size_t)n >= sizeof record ||
+			    ti_snapshot_append(&buffer, record, (size_t)n) != 0)
+				goto fail;
+		}
+		if (ti_snapshot_append(&buffer, "]}\n", 3) != 0)
+			goto fail;
+	}
+	*len = buffer.length;
+	return (buffer.data);
+
+fail:
+	free(buffer.data);
+	*len = 0;
+	cmdq_error(item, "native snapshot exceeds budget or allocation failed");
+	return (NULL);
+}
+
