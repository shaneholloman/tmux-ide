+ * IN AN ACTION OF CONTRACT, NEGLIGENCE OR OTHER TORTIOUS ACTION, ARISING
+ * OUT OF OR IN CONNECTION WITH THE USE OR PERFORMANCE OF THIS SOFTWARE.
+ */
+
+#ifndef TMUX_IDE_SNAPSHOT_BUFFER_H
+#define TMUX_IDE_SNAPSHOT_BUFFER_H
+
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+
+#ifndef TI_SNAPSHOT_REALLOC
+#define TI_SNAPSHOT_REALLOC realloc
+#endif
+
+/* Payload limit excludes the terminating NUL; allocated capacity includes it. */
+struct ti_snapshot_buffer {
+	char	*data;
+	size_t	 length, capacity, limit;
+};
+
+static inline int
+ti_snapshot_append(struct ti_snapshot_buffer *b, const char *data, size_t length)
+{
+	char	*next;
+	size_t	 needed, capacity;
+
+	if (b->limit == SIZE_MAX || b->length > b->limit ||
+	    length > b->limit - b->length)
+		return (-1);
+	needed = b->length + length + 1;
+	if (needed > b->capacity) {
+		capacity = b->capacity;
+		if (capacity == 0)
+			capacity = b->limit < 4095 ? b->limit + 1 : 4096;
+		while (capacity < needed) {
+			if (capacity > (b->limit + 1) / 2)
+				capacity = b->limit + 1;
+			else
+				capacity *= 2;
+		}
+		next = TI_SNAPSHOT_REALLOC(b->data, capacity);
+		if (next == NULL)
+			return (-1);
+		b->data = next;
+		b->capacity = capacity;
+	}
+	if (length != 0)
+		memcpy(b->data + b->length, data, length);
+	b->length += length;
+	b->data[b->length] = '\0';
+	return (0);
+}
+
+#endif
