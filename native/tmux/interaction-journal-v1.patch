+	record.derivation = origin->derivation;
+	record.kind = kind;
+	record.outcome = outcome;
+	record.target_id = target;
+	record.target_birth_id = target_birth;
+	record.flags = flags;
+	if (clock_gettime(CLOCK_MONOTONIC, &now) == 0)
+		record.monotonic_us =
+		    (uint64_t)now.tv_sec * 1000000 + now.tv_nsec / 1000;
+	tmux_ide_interaction_append(&record);
+}
+/* Fixed synchronous aggregation: never retained across an event-loop yield. */
+#define TI_EFFECT_TARGETS 64
+static struct {
+	unsigned depth, used;
+	uint64_t command;
+	struct ti_origin origin;
+	struct {
+		unsigned pane, kind;
+		uint64_t count, birth_id;
+	} targets[TI_EFFECT_TARGETS];
+} ti_effects;
+void
+tmux_ide_interaction_begin(uint64_t command, const struct ti_origin *origin)
+{
+	if (!ti_journal)
+		return;
+	if (ti_effects.depth++) {
+		ti_degrade(8);
+		return;
+	}
+	ti_effects.used = 0;
+	ti_effects.command = command;
+	ti_effects.origin = *origin;
+}
+int
+tmux_ide_interaction_measuring(void)
+{
+	return ti_effects.depth == 1;
+}
+void
+tmux_ide_interaction_effect(unsigned pane, uint64_t birth, unsigned kind,
+			    uint64_t count)
+{
+	unsigned i;
+	if (ti_effects.depth != 1)
+		return;
+	for (i = 0; i < ti_effects.used; i++)
+		if (ti_effects.targets[i].pane == pane &&
+		    ti_effects.targets[i].birth_id == birth &&
+		    ti_effects.targets[i].kind == kind)
+			break;
+	if (i == TI_EFFECT_TARGETS) {
+		ti_degrade(8);
+		return;
+	}
+	if (i == ti_effects.used) {
+		ti_effects.used++;
+		ti_effects.targets[i].pane = pane;
+		ti_effects.targets[i].birth_id = birth;
+		ti_effects.targets[i].kind = kind;
+		ti_effects.targets[i].count = 0;
+	}
+	if (UINT64_MAX - ti_effects.targets[i].count < count) {
+		ti_degrade(8);
+		return;
+	}
+	ti_effects.targets[i].count += count;
+}
+void
+tmux_ide_interaction_end(void)
+{
+	unsigned i;
+	struct ti_record record = {0};
+	struct timespec now;
+	if (!ti_effects.depth || --ti_effects.depth)
+		return;
+	record.command_id = ti_effects.command;
+	memcpy(record.correlation, ti_effects.origin.correlation,
+	       sizeof record.correlation);
+	record.issuer_id = ti_effects.origin.issuer_id;
+	record.request_id = ti_effects.origin.request_id;
+	record.parent_id = ti_effects.origin.parent_id;
+	record.transport = ti_effects.origin.transport;
+	record.derivation = ti_effects.origin.derivation;
+	record.flags = 1;
+	record.outcome = 1;
+	if (clock_gettime(CLOCK_MONOTONIC, &now) == 0)
+		record.monotonic_us =
+		    (uint64_t)now.tv_sec * 1000000 + now.tv_nsec / 1000;
+	for (i = 0; i < ti_effects.used; i++) {
+		record.kind = ti_effects.targets[i].kind;
+		record.target_id = ti_effects.targets[i].pane;
+		record.target_birth_id = ti_effects.targets[i].birth_id;
+		record.count = ti_effects.targets[i].count;
+		tmux_ide_interaction_append(&record);
+	}
+	ti_effects.used = 0;
+}
+void
+tmux_ide_interaction_forget(struct cmdq_item *item)
+{
+	unsigned i;
+	for (i = 0; i < TI_MAX_WAITERS; i++)
+		if (ti_waiters[i].item == item)
+			memset(&ti_waiters[i], 0, sizeof ti_waiters[i]);
+}
+void
+tmux_ide_interaction_client_lost(struct client *client)
+{
+	unsigned i;
+	for (i = 0; i < TI_MAX_WAITERS; i++) {
+		if (ti_waiters[i].client != client)
+			continue;
+		cmdq_continue(ti_waiters[i].item);
+		memset(&ti_waiters[i], 0, sizeof ti_waiters[i]);
+	}
+}
+void
+tmux_ide_interaction_free(void)
+{
+	if (ti_wakeup_initialized)
+		evtimer_del(&ti_wakeup);
+	memset(ti_waiters, 0, sizeof ti_waiters);
+	free(ti_journal);
+	ti_journal = NULL;
+}
+void
+tmux_ide_interaction_append(const struct ti_record *record)
+{
+	if (ti_journal == NULL)
+		return;
+	if (!ti_append(ti_journal, record)) {
+		memset(ti_journal, 0, sizeof *ti_journal);
+		ti_uuid(ti_journal_epoch);
+		(void)ti_append(ti_journal, record);
+	}
+	/* Serialization occurs on a later event-loop turn, never on the
+	 * producer. */
+	if (!ti_wakeup_pending) {
+		ti_wakeup_pending = 1;
+		event_active(&ti_wakeup, EV_TIMEOUT, 1);
+	}
+}
+static int
+ti_decimal(const char *text, uint64_t *value)
+{
+	char *end;
+	const char *p;
+	unsigned long long parsed;
+	if (text == NULL || !*text || strlen(text) > 20)
+		return 0;
+	for (p = text; *p; p++)
+		if (*p < '0' || *p > '9')
+			return 0;
+	errno = 0;
+	parsed = strtoull(text, &end, 10);
+	if (errno || *end || parsed > UINT64_MAX)
+		return 0;
+	*value = parsed;
+	return 1;
+}
+static void
+ti_capability(struct cmdq_item *item)
+{
+	unsigned i, waiting = 0;
+	for (i = 0; i < TI_MAX_WAITERS; i++)
+		if (ti_waiters[i].item)
+			waiting++;
+	cmdq_print(
+	    item,
+	    "{\"schemaVersion\":2,\"type\":\"capability\","
+	    "\"serverEpoch\":\"%s\",\"journalEpoch\":\"%s\",\"enabled\":%s,"
+	    "\"coverage\":[\"command-outcome-v1\",\"pty-enqueue-v1\",\"capture-"
+	    "produced-v1\",\"cooperative-operation-v1\",\"pane-identity-v1\"],\"capacity\":%u,"
+	    "\"maxBatch\":%u,\"maxWaiters\":%u,\"waitingReaders\":%u,"
+	    "\"degraded\":%u,\"readerTransport\":\"sessionless-control-v1\",\"ownedOperationTransport\":\"direct-wrapper-v1\",\"ownedOperationEpochGuard\":\"server-epoch-v1\",\"ownedOperationPaneGuard\":\"direct-pane-v1\",\"ownedOperationSessionGuard\":\"direct-session-v1\"}",
+	    ti_server_epoch, ti_journal_epoch, ti_journal ? "true" : "false",
+	    TI_CAPACITY, TI_MAX_BATCH, TI_MAX_WAITERS, waiting, ti_degraded);
+}
+/* All fields are numbers/enums or internally minted UUIDs. No arbitrary text.
+ */
+static int
+ti_format(char *out, size_t capacity, size_t *used, const char *fmt, ...)
+{
+	int n;
+	va_list ap;
+	if (*used >= capacity)
+		return 0;
+	va_start(ap, fmt);
+	n = vsnprintf(out + *used, capacity - *used, fmt, ap);
+	va_end(ap);
+	if (n < 0 || (size_t)n >= capacity - *used)
+		return 0;
+	*used += n;
+	return 1;
+}
+static void
+ti_read(struct cmdq_item *item, const char *epoch, uint64_t after,
+	unsigned limit)
+{
+	char out[131072];
+	size_t used = 0;
+	uint64_t oldest, first, last, seq;
+	const struct ti_record *record;
+	if (strcmp(epoch, ti_journal_epoch)) {
+		cmdq_print(item,
+			   "{\"schemaVersion\":2,\"type\":\"reset\","
+			   "\"serverEpoch\":\"%s\",\"journalEpoch\":\"%s\"}",
+			   ti_server_epoch, ti_journal_epoch);
+		return;
+	}
+	if (after > ti_journal->newest) {
+		cmdq_error(item, "invalid journal cursor");
+		return;
+	}
+	oldest = ti_oldest(ti_journal);
+	first = after == UINT64_MAX ? UINT64_MAX : after + 1;
+	if (first < oldest)
+		first = oldest;
+	last = after;
+#define TI_OUT(...)                                                            \
+	do {                                                                   \
+		if (!ti_format(out, sizeof out, &used, __VA_ARGS__))           \
+			goto too_large;                                        \
+	} while (0)
+	TI_OUT("{\"schemaVersion\":2,\"type\":\"batch\",\"serverEpoch\":\"%s\","
+	       "\"journalEpoch\":\"%s\",\"oldest\":\"%" PRIu64
+	       "\",\"newest\":\"%" PRIu64 "\",\"gap\":",
+	       ti_server_epoch, ti_journal_epoch, oldest, ti_journal->newest);
+	if (after < oldest - 1)
+		TI_OUT("{\"from\":\"%" PRIu64 "\",\"through\":\"%" PRIu64 "\"}",
+		       after + 1, oldest - 1);
+	else
+		TI_OUT("null");
+	TI_OUT(",\"records\":[");
+	for (seq = first; seq <= ti_journal->newest && limit && seq > after;
+	     seq++, limit--) {
+		record = ti_at(ti_journal, seq);
+		if (record == NULL)
+			break;
+		TI_OUT(
+		    "%s{\"sequence\":\"%" PRIu64 "\",\"commandId\":\"%" PRIu64
+		    "\",\"issuerId\":\"%" PRIu64 "\",\"monotonicUs\":\"%" PRIu64
+		    "\",\"count\":\"%" PRIu64
+		    "\",\"targetBirthId\":\"%" PRIu64 "\",\"targetId\":%u,\"kind\":%u,\"outcome\":%u,\"flags\":%"
+		    "u,\"requestId\":\"%" PRIu64
+		    "\",\"parentCommandId\":\"%" PRIu64
+		    "\",\"transport\":%u,\"derivation\":%u,\"correlation\":%s%"
+		    "s%s}",
+		    seq == first ? "" : ",", record->sequence,
+		    record->command_id, record->issuer_id, record->monotonic_us,
+		    record->count, record->target_birth_id, record->target_id, record->kind,
+		    record->outcome, record->flags, record->request_id,
+		    record->parent_id, record->transport, record->derivation,
+		    record->correlation[0] ? "\"" : "",
+		    record->correlation[0] ? record->correlation : "null",
+		    record->correlation[0] ? "\"" : "");
+		last = seq;
+		if (seq == UINT64_MAX)
+			break;
+	}
+	TI_OUT("],\"next\":\"%" PRIu64 "\",\"degraded\":%u}", last,
+	       ti_degraded);
+	cmdq_print(item, "%s", out);
+	return;
+too_large:
+	cmdq_error(item, "journal serialization limit exceeded");
+#undef TI_OUT
+}
+static void
+ti_wake(__unused int fd, __unused short events, __unused void *arg)
+{
+	unsigned i;
+	struct ti_waiter waiter;
+	ti_wakeup_pending = 0;
+	for (i = 0; i < TI_MAX_WAITERS; i++) {
+		if (!ti_waiters[i].item)
+			continue;
+		waiter = ti_waiters[i];
+		memset(&ti_waiters[i], 0, sizeof ti_waiters[i]);
+		if (!(waiter.client->flags & CLIENT_DEAD)) {
+			ti_read(waiter.item, waiter.epoch, waiter.after,
+				waiter.limit);
+			if (waiter.client->flags & CLIENT_JOURNAL_READER)
+				cmdq_guard(waiter.item, "end", 1);
+		}
+		cmdq_continue(waiter.item);
+	}
+}
+static enum cmd_retval
+ti_exec(struct cmd *cmd, struct cmdq_item *item)
+{
+	struct args *args = cmd_get_args(cmd);
+	struct client *client = cmdq_get_origin_client(item);
+	uint64_t after, limit = TI_MAX_BATCH;
+	const char *epoch;
+	unsigned i;
+	int modes = args_has(args, 'P') + args_has(args, 'V') + args_has(args, 'e') +
+		    args_has(args, 'i') + args_has(args, 'r');
+	ti_initialize();
+#ifdef TMUX_IDE_JOURNAL_TEST
+	if (args_has(args, 'B')) {
+		ti_pane_birth_counter = UINT64_MAX;
+		return CMD_RETURN_NORMAL;
+	}
+	if (args_has(args, 'D')) {
+		ti_connection_counter = ti_request_counter =
+		    ti_command_counter = UINT64_MAX;
+		ti_degrade(1 | 2 | 4);
+		return CMD_RETURN_NORMAL;
+	}
+	if (args_has(args, 'X')) {
+		struct ti_record record = {0};
+		if (!ti_journal) {
+			cmdq_error(item, "journal disabled");
+			return CMD_RETURN_ERROR;
+		}
+		ti_journal->newest = UINT64_MAX;
+		tmux_ide_interaction_append(&record);
+		return CMD_RETURN_NORMAL;
+	}
+	if (args_has(args, 'T') || args_has(args, 'W')) {
+		struct ti_record record = {0};
+		if (!ti_journal) {
+			cmdq_error(item, "journal disabled");
+			return CMD_RETURN_ERROR;
+		}
+		if (args_has(args, 'W')) {
+			memset(&record, 0xff, sizeof record);
+			memcpy(record.correlation,
+			       "ffffffff-ffff-4fff-bfff-ffffffffffff", 37);
+		}
+		record.kind = 255;
+		record.issuer_id = client ? client->tmux_ide_connection_id : 0;
+		tmux_ide_interaction_append(&record);
+		return CMD_RETURN_NORMAL;
+	}
+#endif
+	if (modes != 1 || (!args_has(args, 'r') &&
+			   (args_has(args, 'w') || args_has(args, 'E') ||
+			    args_has(args, 'a') || args_has(args, 'n')))) {
+		cmdq_error(item, "invalid journal arguments");
+		return CMD_RETURN_ERROR;
+	}
+	if (args_has(args, 'e') && !ti_journal) {
+#ifdef TMUX_IDE_JOURNAL_TEST
+		if (args_has(args, 'F'))
+			ti_journal = NULL;
+		else
+#endif
+			ti_journal = calloc(1, sizeof *ti_journal);
+		if (!ti_journal) {
+			cmdq_error(item, "journal allocation unavailable; "
+					 "terminal operation unaffected");
+			return CMD_RETURN_ERROR;
+		}
+	}
+	if (args_has(args, 'P')) {
+		struct client *other;
+		unsigned readers = 0;
+		TAILQ_FOREACH(other, &clients, entry)
+			if (other->flags & CLIENT_JOURNAL_READER)
+				readers++;
+		if (!client || !(client->flags & CLIENT_JOURNAL_READER) ||
+		    client->session || !client->tmux_ide_connection_id ||
+		    !ti_journal || readers > TI_MAX_WAITERS) {
+			if (client && (client->flags & CLIENT_JOURNAL_READER)) {
+				client->flags |= CLIENT_EXIT;
+			}
+			cmdq_error(item, "sessionless journal reader unavailable");
+			return CMD_RETURN_ERROR;
+		}
+		ti_capability(item);
+		cmdq_print(item, "{\"schemaVersion\":2,\"type\":\"identity\","
+		    "\"serverEpoch\":\"%s\",\"connectionId\":\"%" PRIu64 "\"}",
+		    ti_server_epoch, client->tmux_ide_connection_id);
+		return CMD_RETURN_NORMAL;
+	}
+	if (args_has(args, 'V') || args_has(args, 'e')) {
+		ti_capability(item);
+		return CMD_RETURN_NORMAL;
+	}
+	if (args_has(args, 'i')) {
+		cmdq_print(item,
+			   "{\"schemaVersion\":2,\"type\":\"identity\","
+			   "\"serverEpoch\":\"%s\",\"connectionId\":\"%" PRIu64
+			   "\"}",
+			   ti_server_epoch,
+			   cmdq_origin_child(item, TI_CHILD).issuer_id);
+		return CMD_RETURN_NORMAL;
+	}
+	if (!ti_journal) {
+		cmdq_error(item, "journal disabled");
+		return CMD_RETURN_ERROR;
+	}
+	epoch = args_get(args, 'E');
+	if (!epoch || strlen(epoch) != 36 ||
+	    !ti_decimal(args_get(args, 'a'), &after) ||
+	    (args_has(args, 'n') && (!ti_decimal(args_get(args, 'n'), &limit) ||
+				     limit < 1 || limit > TI_MAX_BATCH))) {
+		cmdq_error(item, "invalid journal cursor arguments");
+		return CMD_RETURN_ERROR;
+	}
+	if (strcmp(epoch, ti_journal_epoch) || !args_has(args, 'w') ||
+	    after != ti_journal->newest || ti_degraded) {
+		ti_read(item, epoch, after, (unsigned)limit);
+		return CMD_RETURN_NORMAL;
+	}
+	if (!client) {
+		cmdq_error(item, "journal wait requires originating client");
+		return CMD_RETURN_ERROR;
+	}
+	for (i = 0; i < TI_MAX_WAITERS; i++)
+		if (!ti_waiters[i].item) {
+			ti_waiters[i].item = item;
+			ti_waiters[i].client = client;
+			ti_waiters[i].after = after;
+			ti_waiters[i].limit = (unsigned)limit;
+			memcpy(ti_waiters[i].epoch, epoch, 37);
+			return CMD_RETURN_WAIT;
+		}
+	cmdq_error(item, "journal waiter limit exceeded");
+	return CMD_RETURN_ERROR;
+}
+
+/* An explicit cooperative assertion, never independently authenticated
+ * identity. */
+static enum args_parse_type
+ti_run_parse(__unused struct args *args, __unused u_int idx,
+	     __unused char **cause)
+{
+	return ARGS_PARSE_COMMANDS_OR_STRING;
+}
+static int
+ti_operation_uuid(const char *value)
+{
+	unsigned i;
+	if (!value || strlen(value) != 36)
+		return 0;
+	for (i = 0; i < 36; i++) {
+		if (i == 8 || i == 13 || i == 18 || i == 23) {
+			if (value[i] != '-')
+				return 0;
+		} else if (!((value[i] >= '0' && value[i] <= '9') ||
+			     (value[i] >= 'a' && value[i] <= 'f') ||
+			     (value[i] >= 'A' && value[i] <= 'F')))
+			return 0;
+	}
+	return value[14] >= '1' && value[14] <= '8' &&
+	       (value[19] == '8' || value[19] == '9' || value[19] == 'a' ||
+		value[19] == 'A' || value[19] == 'b' || value[19] == 'B');
+}
+static enum cmd_retval
+ti_run_exec(struct cmd *self, struct cmdq_item *item)
+{
+	struct args *args = cmd_get_args(self);
+	const char *operation = args_get(args, 'O');
+	const char *expected_epoch = args_get(args, 'E');
+	const char *expected_pane = args_get(args, 't');
+	const char *expected_birth = args_get(args, 'B');
+	const char *expected_name = args_get(args, 's');
+	const char *expected_session = args_get(args, 'S');
+	const char *expected_created = args_get(args, 'C');
+	uint64_t session_id = 0, session_created = 0;
+	struct session *guard_session;
+	struct ti_session_guard *session_guard = NULL;
+	struct cmd *check_command;
+	unsigned command_count = 0;
+	uint64_t pane_id, birth_id;
+	struct window_pane *guard_pane;
+	struct cmd_list *commands;
+	struct cmd_parse_result *parsed;
+	struct cmd_parse_input parse = { .flags = CMD_PARSE_NOALIAS | CMD_PARSE_PARSEONLY };
+	struct args_value *body = args_value(args, 0);
+	struct cmdq_item *child;
+	struct ti_origin origin = cmdq_origin_child(item, TI_CHILD);
+	struct client *client = cmdq_get_origin_client(item);
+	if (expected_epoch && (!args_has(args, 'I') ||
+	    !ti_operation_uuid(expected_epoch) ||
+	    strcmp(expected_epoch, ti_server_epoch) != 0)) {
+		cmdq_error(item, "operation server epoch mismatch");
+		return CMD_RETURN_ERROR;
+	}
+	if (!ti_operation_uuid(operation)) {
+		cmdq_error(item, "operation must be a canonical UUID");
+		return CMD_RETURN_ERROR;
+	}
+	if (expected_pane || expected_birth) {
+		if (!args_has(args, 'I') || !expected_epoch ||
+		    !expected_pane || expected_pane[0] != '%' ||
+		    !ti_decimal(expected_pane + 1, &pane_id) ||
+		    (expected_pane[1] == '0' && expected_pane[2] != '\0') ||
+		    pane_id > UINT32_MAX || !ti_decimal(expected_birth, &birth_id) ||
+		    !birth_id || expected_birth[0] == '0') {
+			cmdq_error(item, "invalid operation pane guard");
+			return CMD_RETURN_ERROR;
+		}
+		guard_pane = window_pane_find_by_id((u_int)pane_id);
+		if (!guard_pane || guard_pane->tmux_ide_birth_id != birth_id) {
+			cmdq_error(item, "operation pane lifetime mismatch");
+			return CMD_RETURN_ERROR;
+		}
+		origin.guard_wrapper_id = origin.parent_id;
+		origin.guard_pane_id = (uint32_t)pane_id;
+		origin.guard_birth_id = birth_id;
+	}
+	if (expected_name || expected_session || expected_created) {
+		if (!args_has(args, 'I') || !expected_epoch || !expected_name ||
+		    !*expected_name || strlen(expected_name) > 4096 ||
+		    !expected_session || expected_session[0] != '$' ||
+		    !ti_decimal(expected_session + 1, &session_id) ||
+		    (expected_session[1] == '0' && expected_session[2] != '\0') ||
+		    session_id > UINT32_MAX ||
+		    !ti_decimal(expected_created, &session_created) ||
+		    (expected_created[0] == '0' && expected_created[1] != '\0')) {
+			cmdq_error(item, "invalid operation session guard");
+			return CMD_RETURN_ERROR;
+		}
+		guard_session = session_find(expected_name);
+		if (!guard_session || guard_session->id != (u_int)session_id ||
+		    guard_session->creation_time.tv_sec < 0 ||
+		    (uint64_t)guard_session->creation_time.tv_sec != session_created) {
+			cmdq_error(item, "operation session lifetime mismatch");
+			return CMD_RETURN_ERROR;
+		}
+	}
+	if (args_has(args, 'I') && (!ti_journal || !origin.parent_id ||
+	    !origin.issuer_id || !client ||
+	    client->tmux_ide_connection_id != origin.issuer_id)) {
+		cmdq_error(item, "operation identity unavailable");
+		return CMD_RETURN_ERROR;
+	}
+	if (args_has(args, 'I')) {
+		if (!body || body->type != ARGS_STRING) {
+			cmdq_error(item, "operation identity requires a string command body");
+			return CMD_RETURN_ERROR;
+		}
+		parse.c = client;
+		cmd_find_copy_state(&parse.fs, cmdq_get_target(item));
+		parsed = cmd_parse_from_string(body->string, &parse);
+		if (parsed->status != CMD_PARSE_SUCCESS) {
+			cmdq_error(item, "%s", parsed->error);
+			free(parsed->error);
+			return CMD_RETURN_ERROR;
+		}
+		commands = parsed->cmdlist;
+	} else {
+		commands = args_make_commands_now(self, item, 0, 0);
+		if (!commands)
+			return CMD_RETURN_ERROR;
+	}
+	if (expected_name) {
+		for (check_command = cmd_list_first(commands); check_command;
+		    check_command = cmd_list_next(check_command)) {
+			if (++command_count > 64)
+				break;
+		}
+		if (command_count <= 64)
+			session_guard = cmdq_session_guard_new(expected_name,
+			    (u_int)session_id, session_created);
+		if (!session_guard) {
+			cmd_list_free(commands);
+			cmdq_error(item, "operation session guard unavailable");
+			return CMD_RETURN_ERROR;
+		}
+	}
+	if (args_has(args, 'I'))
+		cmdq_print(item, "{\"schemaVersion\":2,\"type\":\"operation-identity\","
+		    "\"serverEpoch\":\"%s\",\"connectionId\":\"%" PRIu64
+		    "\",\"wrapperCommandId\":\"%" PRIu64 "\",\"operationId\":\"%s\"}",
+		    ti_server_epoch, origin.issuer_id, origin.parent_id, operation);
+	memcpy(origin.correlation, operation, sizeof origin.correlation);
+	child = cmdq_get_command(commands, cmdq_get_state(item));
+	if (args_has(args, 'I'))
+		cmd_list_free(commands);
+	cmdq_set_origin(child, &origin);
+	cmdq_set_session_guard(child, session_guard);
+	cmdq_session_guard_free(session_guard);
+	cmdq_insert_after(item, child);
+	return CMD_RETURN_NORMAL;
+}
+const struct cmd_entry cmd_tmux_ide_run_entry = {
+    .name = "tmux-ide-run",
+    .alias = NULL,
+    .args = {"B:C:E:IO:S:s:t:", 1, 1, ti_run_parse},
+    .usage = "[-I [-E server-epoch [-t pane-id -B birth-id] [-s session-name -S session-id -C created]]] -O operation-uuid { commands }",
+    .flags = 0,
+    .exec = ti_run_exec};
diff --git a/tmux-ide-journal.h b/tmux-ide-journal.h
new file mode 100644
index 0000000..5fd589b
--- /dev/null
+++ b/tmux-ide-journal.h
@@ -0,0 +1,75 @@
+/*
